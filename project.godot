; Ecoterra: Despertar — projeto Godot 4.5

config_version=5

[application]

config/name="Ecoterra: Despertar"
config/description="Sobrevivência com Ecos (monstros) em mundo aberto, progressão linear e modo sandbox."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.08, 0.12, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

Game="*res://src/services/game.gd"
Audio="*res://src/services/audio.gd"
Ads="*res://src/services/ads.gd"
Firebase="*res://src/services/firebase.gd"
Billing="*res://src/services/billing.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.45, 0.65, 0.85, 1)
